{
  "name": "Forms API",
  "image": "mcr.microsoft.com/vscode/devcontainers/base:debian@sha256:1a00517e89d3075f8c9dc8d9911404de0ff8991a4d71c62068573e9b016a89da",
  "containerEnv": {
    "SHELL": "/bin/zsh"
  },
  "features": {
    "aws-cli": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.23.2"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.vscode-github-actions",
        "biomejs.biome",
        "vitest.explorer",
        "ms-python.python",
        "ms-python.black-formatter"
      ]
    }
  },
  "appPort": [3001],
  "postCreateCommand": "npm i -g corepack@latest && corepack enable pnpm && pnpm config set store-dir /home/vscode/pnpm/store && corepack use pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664 && pnpm install",
  "remoteUser": "vscode"
}
